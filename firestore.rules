rules_version = '2';

// ============================================================================
// Grant Receipt Assistant — Firestore Security Rules
//
// สถานะปัจจุบัน (2026-09-05): มี Firebase Auth (Email/Password) จริงแล้ว — บังคับสิทธิ์ตามเจ้าของ
// (owner-based) ตาม FR-12/NFR-05 ทุก path ที่ผูกกับผู้ใช้คนใดคนหนึ่ง ดู app/login.html,
// app/signup.html, app/js/auth-guard.js สำหรับฝั่ง client และ ACL.md สำหรับที่มาของกฎชุดนี้
//
// โครงสร้าง collection (nest ตามความเป็นเจ้าของ):
//   users/{userId}/projects/{projectId}/receipts/{receiptId}/files/{fileId}
//   fundSources/{fundSourceId}/ruleVersions/{ruleVersionId}/ruleItems/{ruleItemId}
// รูปแบบ rule ของ receipts/files ใช้ 2 ชุดคู่กัน (ทดสอบจริงกับ Firestore แล้วจำเป็นต้องมีทั้งคู่):
//   1) concrete path เต็มเส้นทาง (users/.../projects/.../receipts/.../files/...) สำหรับ
//      อ่าน/เขียนไฟล์แนบจริง — nest match /files ใต้ match ที่ใช้ wildcard (`{path=**}`) แล้ว
//      อ่าน subcollection files ไม่ได้ (permission-denied) แม้ path จะตรงตามที่ตั้งใจ จึงต้อง
//      ประกาศแบบ concrete ทั้งเส้นเท่านั้น — ที่นี่เช็คสิทธิ์จาก path variable {userId} ได้ตรงๆ
//   2) recursive wildcard (`{path=**}/receipts/{receiptId}`) แยกต่างหาก สำหรับ collection group
//      query ข้ามโครงการ (db.collectionGroup("receipts")) ที่ app/js/receipts.js กับ
//      app/js/new-receipt.js ใช้ — ตรง path ไม่มีตัวแปร {userId} ให้เช็คตรงๆ (path=** กลืนไปหมด)
//      จึงต้องเช็คจาก field ownerUserId ที่ denormalize ไว้บนเอกสาร receipt เอง (ทุกจุดที่เขียน
//      receipt ต้องใส่ field นี้เสมอ — ดู app/js/seed.js, app/js/new-receipt.js) แทน และทั้งสอง
//      หน้าที่ query แบบ collectionGroup ต้องมี .where("ownerUserId", "==", uid) กำกับเสมอ เพราะ
//      Firestore บังคับให้ query ที่จะผ่าน field-based rule ได้ต้องมี where เท่ากับ field นั้นจริง
//      (ไม่ใช่แค่ rule filter ผลลัพธ์ทีหลัง — query ทั้งชุดจะถูกปฏิเสธถ้าไม่มี where กำกับ)
//
// fundSources/ruleVersions/ruleItems เป็นข้อมูลระดับองค์กร ไม่มีเจ้าของเป็นนักวิจัยคนใดคนหนึ่ง
// (ตาม docs/02-design/02-technical/detailed-design/access-control.md กฎข้อ 3) — อ่านได้ทุกบัญชีที่
// ล็อกอินแล้ว (นักวิจัยต้องเห็นรายชื่อแหล่งทุนตอนสร้างโครงการที่ app/projects.html) แต่เขียนได้
// เฉพาะบัญชีที่มี field isAdmin == true บนเอกสาร users/{uid} ของตัวเองเท่านั้น (เพิ่มเมื่อ
// app/fund-sources.html ถูกสร้างขึ้นให้ admin เพิ่มแหล่งทุนเอง — ไม่มี UI ตั้ง admin คนแรก ต้องตั้ง
// isAdmin: true ผ่าน Firebase Console ด้วยมือ ดู CLAUDE.md หัวข้อ Auth)
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      // create/update แยกจาก read/delete เพราะต้องกันไม่ให้เจ้าของบัญชีตั้ง isAdmin ให้ตัวเองผ่าน
      // client SDK ได้ (เจอจริงระหว่างตั้งบัญชี admin คนแรก — ถ้าใช้ allow write เฉยๆ เหมือนเดิม
      // ผู้ใช้ทุกคนเขียน isAdmin: true ให้ตัวเองได้เลย ทำให้กฎ admin-only ของ fundSources ไร้ความหมาย)
      // isAdmin จึงตั้งได้เฉพาะผ่าน Firebase Console/Admin SDK เท่านั้น (ข้าม rules ได้โดยตรง)
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == false;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);

      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // ประกาศ receipts/files แบบ concrete (ไม่ใช้ wildcard) ตรงนี้ เพราะทดสอบจริงแล้วพบว่า
        // การ nest match /files ไว้ใต้ match /{path=**}/receipts/{receiptId} (แบบ wildcard)
        // ใช้อ่าน subcollection files ไม่ได้ (permission-denied) แม้ path จะตรงตามที่ตั้งใจ —
        // ประกาศแบบ concrete ตรงๆ ทั้งเส้นทางแบบนี้ทำงานถูกต้อง — ที่นี่ {userId} ยังอยู่ใน scope
        // จาก match ด้านบน จึงเช็คตรงกับ auth.uid ได้เลย ไม่ต้องพึ่ง field ownerUserId
        match /receipts/{receiptId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;

          match /files/{fileId} {
            allow read, write: if request.auth != null && request.auth.uid == userId;
          }
        }
      }
    }

    // rule แยกต่างหากสำหรับ collection group query ข้ามโครงการ (db.collectionGroup("receipts")
    // ที่ app/js/receipts.js กับ app/js/new-receipt.js ใช้) — ต้องมี rule รูปแบบ recursive wildcard
    // นี้เพิ่มอีกชุด ถึงจะอนุญาต query แบบข้าม path ได้ (rule concrete ข้างบนอนุญาตแค่ query ตรงต่อ
    // 1 โครงการ ไม่ครอบคลุม query ข้ามโครงการ) ไม่ต้อง nest match /files ซ้ำใต้อันนี้อีก เพราะ
    // rule concrete ด้านบนดูแล path files ให้ครบแล้ว — เช็คจาก resource.data.ownerUserId เพราะ
    // path=** ไม่มีตัวแปร {userId} ให้ใช้ตรงๆ (ต้องคู่กับ .where("ownerUserId", "==", uid) ฝั่ง client)
    match /{path=**}/receipts/{receiptId} {
      allow read: if request.auth != null && resource.data.ownerUserId == request.auth.uid;
      allow write: if request.auth != null
        && request.resource.data.ownerUserId == request.auth.uid;
    }

    // fundSources/ruleVersions/ruleItems เป็นข้อมูลอ้างอิงกลาง (ระเบียบแหล่งทุน) ไม่มีเจ้าของ
    // เฉพาะราย — อ่านได้ทุกบัญชีที่ล็อกอินอยู่ แต่เขียนได้เฉพาะ admin (isAdmin == true) เท่านั้น
    // (ดูหัวข้อ fundSources ด้านบนของไฟล์นี้)
    match /fundSources/{fundSourceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

      match /ruleVersions/{ruleVersionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;

        match /ruleItems/{ruleItemId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
        }
      }
    }

    // กันไม่ให้ collection อื่นที่ไม่ได้ประกาศไว้ข้างบนถูกอ่าน/เขียนโดยไม่ตั้งใจ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
