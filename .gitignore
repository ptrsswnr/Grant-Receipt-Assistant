.obsidian/workspace.json
.obsidian/workspace-mobile.json
.trash/

# ─── Secrets / local config — never commit ───
# Env files (none tracked today, but guard against future ones)
.env
.env.*
!.env.example

# Local-only OpenRouter API key for AI receipt reading (test only — see CLAUDE.md
# "AI receipt reading (test only)"). Never deployed, never committed.
app/js/ai-config.local.js

# Firebase/GCP service account keys — real secrets if this repo ever adds server-side
# admin access (Cloud Functions, scripts using firebase-admin). The Web SDK apiKey in
# app/js/firebase-config.js is NOT a secret (see that file's own comment) and stays committed —
# real access control is Firestore/Storage Security Rules, not that key.
*serviceAccountKey*.json
*firebase-adminsdk*.json
google-credentials*.json
*.pem
*.key

# Firebase CLI local artifacts (debug logs, hosting/emulator cache) — machine-specific, not secret
# by themselves, but noisy and sometimes embed local file paths
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
.firebase/

# Local OCR research setup (research/ocr) — venv, downloaded model weights, and receipt images/
# OCR output, which may contain personal data (names, ID numbers) and must never be committed
research/ocr/.venv/
research/ocr/OpenThai2.0-OCR-Text/
research/ocr/samples/
research/ocr/output/
__pycache__/

# In case a local npm install ever happens in this repo (firebase-tools is installed globally
# for this project, not locally — see CLAUDE.md)
node_modules/

# Design-review artifacts: Playwright logs/snapshots and screenshot evidence (regenerated per review)
.playwright-mcp/
.impeccable/review/

# Evaluation harness (research/eval) — real labelled receipts from finance, run reports, and the
# local AI config for the LLM-only baseline. cases.example.csv (made-up cases) stays committed.
research/eval/data/
research/eval/output/
research/eval/ai-config.local.json
